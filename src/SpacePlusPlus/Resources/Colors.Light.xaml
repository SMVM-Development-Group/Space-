<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Space++ light theme (same keys as dark theme) -->

    <SolidColorBrush x:Key="Bg0" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Bg1" Color="#EBEDF1"/>
    <SolidColorBrush x:Key="Bg2" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg3" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="BgHover" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="BgPressed" Color="#D9DDE4"/>
    <SolidColorBrush x:Key="BgActive" Color="#E8EAF0"/>

    <SolidColorBrush x:Key="Accent" Color="#D32F2F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#B22B27"/>
    <SolidColorBrush x:Key="AccentDim" Color="#26D32F2F"/>
    <SolidColorBrush x:Key="AccentFaint" Color="#14D32F2F"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#1B1C20"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A5C64"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8B8D95"/>

    <SolidColorBrush x:Key="Success" Color="#2E9E63"/>
    <SolidColorBrush x:Key="SuccessDim" Color="#262E9E63"/>
    <SolidColorBrush x:Key="Warning" Color="#C08A1E"/>
    <SolidColorBrush x:Key="WarningDim" Color="#26C08A1E"/>
    <SolidColorBrush x:Key="Error" Color="#D84343"/>
    <SolidColorBrush x:Key="ErrorDim" Color="#26D84343"/>

    <SolidColorBrush x:Key="ControlBorder" Color="#D6D8DD"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#E4E6EA"/>

    <SolidColorBrush x:Key="TooltipBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>

    <!-- Treemap palette -->
    <SolidColorBrush x:Key="TreemapDirLow" Color="#D8DEEA"/>
    <SolidColorBrush x:Key="TreemapDirHigh" Color="#A9B8D4"/>
    <SolidColorBrush x:Key="TreemapFileLow" Color="#E3E5EA"/>
    <SolidColorBrush x:Key="TreemapFileHigh" Color="#C2C7D2"/>
    <SolidColorBrush x:Key="TreemapAggregate" Color="#ECEDEF"/>

</ResourceDictionary>
