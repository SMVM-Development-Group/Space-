<Application x:Class="SpacePlusPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BytesToSizeConverter x:Key="BytesToSize" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisInverted" Inverted="True" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisInverted" Inverted="True" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:CountToVisibilityConverter x:Key="CountToVis" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:BytesToShareTextConverter x:Key="BytesToShare" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:IconKeyConverter x:Key="IconKey" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:BoolToYesNoConverter x:Key="BoolToYesNo" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
            <converters:BytesPerSecondConverter x:Key="BytesPerSecond" xmlns:converters="clr-namespace:SpacePlusPlus.Converters"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
