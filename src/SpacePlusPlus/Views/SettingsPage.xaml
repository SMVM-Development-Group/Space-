<UserControl x:Class="SpacePlusPlus.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Settings row: label left, control right -->
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,24">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Preferences are stored per user in %LOCALAPPDATA%\SpacePlusPlus."
                       Style="{StaticResource SubText}" Margin="0,3,0,18"/>

            <!-- ============ Scanning ============ -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Scanning" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default scan location" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Style="{StaticResource SettingHint}" Margin="0,3,0,0"
                                       Text="Used when starting scans from Overview and Storage Map."/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DefaultScanLocation, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Browse…" Style="{StaticResource BtnSmall}" Command="{Binding BrowseLocationCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource BtnSmall}" Command="{Binding ClearLocationCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Large file threshold" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="{Binding ThresholdHintText}" Style="{StaticResource SettingHint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding ThresholdOption}"
                                  MinWidth="130" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Scan concurrency" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="{Binding ConcurrencyText}" Style="{StaticResource SettingHint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Value="{Binding Concurrency}" Minimum="{Binding ConcurrencyMinimum}"
                                Maximum="{Binding ConcurrencyMaximum}" TickFrequency="1" IsSnapToTickEnabled="True"
                                MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Excluded directories" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Style="{StaticResource SettingHint}" Margin="0,3,0,0"
                                       Text="Folder names (e.g. node_modules) or full paths that the scanner skips entirely."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. node_modules or D:\Backups" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Add" Style="{StaticResource BtnSmall}"
                                        Command="{Binding AddExclusionCommand}" Margin="8,0,0,0" MinWidth="70"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExcludedDirectories}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                                                BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,2,6,2">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource BtnIcon}" Width="20" Height="20"
                                                        Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"
                                                          Width="9" Height="9"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Appearance & system ============ -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; system" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Style="{StaticResource SettingHint}" Margin="0,3,0,0"
                                       Text="Applied immediately and stored on save."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                  MinWidth="130" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}"
                                  Content="Register Space++ for the current user's startup" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Log file" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="{Binding LogDirectoryText}" Style="{StaticResource SettingHint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox IsChecked="{Binding EnableFileLogging}" Content="Write diagnostic logs to disk"
                                      VerticalAlignment="Top"/>
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Margin="0,8,0,0"
                                      MinWidth="130" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Safety ============ -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding ConfirmDeletions}" Margin="0,0,0,10"
                              Content="Always confirm before deleting files or emptying the Recycle Bin"/>
                    <CheckBox IsChecked="{Binding ConfirmCleanup}"
                              Content="Always confirm before running a cleanup category"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="History retention" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="{Binding RetentionText}" Style="{StaticResource SettingHint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Value="{Binding HistoryRetention}" Minimum="5" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Save ============ -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource BtnPrimary}" MinWidth="130"
                        Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                <Button Content="Restore defaults" Style="{StaticResource ButtonBaseStyle}"
                        Command="{Binding ResetDefaultsCommand}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
