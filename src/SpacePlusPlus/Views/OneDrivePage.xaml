<UserControl x:Class="SpacePlusPlus.Views.OneDrivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconOneDrive}" Style="{StaticResource IconPath}" Width="24" Height="24"
                      VerticalAlignment="Center"/>
                <TextBlock Text="OneDrive" Style="{StaticResource PageTitle}" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" Margin="12,3,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnSmall}" Command="{Binding CancelCommand}" MinWidth="76"
                        Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Analyze" Style="{StaticResource BtnSmall}" Command="{Binding AnalyzeCommand}"
                        IsEnabled="{Binding IsAnalyzing, Converter={StaticResource BoolToVisInverted}}" MinWidth="90"/>
            </StackPanel>
        </Grid>

        <!-- Unavailable state -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18" Margin="0,16,0,0"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisInverted}}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Width="24" Height="24"
                      HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Text="OneDrive was not detected" Style="{StaticResource AppText}" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="No OneDrive folder is configured for this Windows account. Set up OneDrive, or sign in, and this page will analyze files with the Windows Cloud Files (cloud filter) API."/>
            </StackPanel>
        </Border>

        <!-- Warning when cloud filter off -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,14" Margin="0,16,0,0"
                Visibility="{Binding CloudFilesAvailable, Converter={StaticResource BoolToVisInverted}}"
                BorderBrush="{DynamicResource Warning}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPath}" Width="16" Height="16"
                      Stroke="{DynamicResource Warning}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource SubText}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="720"
                           Text="The Windows Cloud Files filter driver (CldFlt) is disabled. Freeing local space requires it; re-enable it in Windows services."/>
            </StackPanel>
        </Border>

        <!-- Summary + list -->
        <Grid Grid.Row="1" Margin="0,16,0,0"
              Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Summary card -->
            <Border Style="{StaticResource Card}" Grid.Column="0" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Sync state" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding RootPath}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Locally available" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding LocalAvailableText}" Style="{StaticResource StatValue}" FontSize="19"/>
                            <TextBlock Text="{Binding LocalFilesText}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Online-only" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding OnlineOnlyText}" Style="{StaticResource StatValue}" FontSize="19"/>
                            <TextBlock Text="{Binding OnlineFilesText}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Text="Always kept on device" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding PinnedText}" Style="{StaticResource StatValue}" FontSize="19"/>
                            <TextBlock Text="{Binding PinnedFilesText}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Grid>
                    <Separator Style="{StaticResource HSeparator}" Margin="0,12,0,10"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCloudDownload}" Style="{StaticResource IconPath}"
                                  Width="18" Height="18" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Reclaimable local storage" Style="{StaticResource SubText}"/>
                                    <TextBlock Text="{Binding ReclaimableText}" Style="{StaticResource AppText}"
                                               FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ReclaimableFilesText}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="Freeing space dehydrates files: the cloud copy is never touched and locally available files become online-only. Files kept on device ('pinned') are left alone."/>
                </StackPanel>
            </Border>

            <!-- Actions card -->
            <Border Style="{StaticResource Card}" Grid.Column="2" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource SubText}" Margin="0,6,0,10"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Select all eligible" Style="{StaticResource BtnSmall}" MinWidth="120"
                                Command="{Binding SelectAllEligibleCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear" Style="{StaticResource BtnSmall}" MinWidth="70"
                                Command="{Binding ClearSelectionCommand}"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnPrimary}" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding MakeOnlineOnlyCommand}" IsEnabled="{Binding CanDehydrate}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCloud}" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                            <TextBlock Text="Free up space (make online-only)" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsDehydrating, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DehydrateProgressText}" Style="{StaticResource SubText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"
                               Visibility="{Binding CurrentFile, Converter={StaticResource NullToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding HasResultSummary, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="14" Height="14"
                              Stroke="{DynamicResource Success}" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SubText}" Margin="8,0,0,0"
                                   TextWrapping="Wrap" MaxWidth="290" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- File list -->
        <Border Grid.Row="2" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" ClipToBounds="True"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search files…"
                             VerticalContentAlignment="Center" Padding="8,4"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding StateFilters}" SelectedItem="{Binding StateFilter}"
                              MinWidth="150" VerticalContentAlignment="Center"/>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ItemsView}"
                          IsReadOnly="True" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEligible}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" MinWidth="150"/>
                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="170"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ListTruncated, Converter={StaticResource BoolToVis}}"
                   Text="The list shows the first 4,000 files for performance; all totals and the reclaimable estimate cover the complete OneDrive folder."/>
    </Grid>
</UserControl>
