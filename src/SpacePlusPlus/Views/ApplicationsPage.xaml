<UserControl x:Class="SpacePlusPlus.Views.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Applications" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource SubText}" Margin="12,3,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Measure install sizes" Style="{StaticResource BtnSmall}" Command="{Binding MeasureCommand}"
                        IsEnabled="{Binding MeasureButtonEnabled}" Margin="0,0,10,0"
                        ToolTip="Scans the registered install folder on disk. Where it is missing, Space++ derives it from the uninstaller or icon path."/>
                <Button Content="Refresh" Style="{StaticResource BtnSmall}" Command="{Binding RefreshCommand}" MinWidth="86"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,16,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by name or publisher…" VerticalContentAlignment="Center"/>
                <CheckBox Grid.Column="2" Content="Show system components" IsChecked="{Binding IncludeSystemComponents}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding AppsView}"
                      IsReadOnly="True" SelectionMode="Single"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" MinWidth="160"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Reported size" Binding="{Binding ReportedText}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Measured size" Binding="{Binding MeasuredText}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Install location" Binding="{Binding InstallLocation}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,9" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="640"
                               Text="Measured sizes are scanned from the install folder. Some programs do not register one; their row explains why it cannot be measured. Microsoft Store apps are not listed here."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Open uninstaller" Style="{StaticResource BtnPrimary}" MinWidth="130"
                        Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedApp}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
