<dialogs:SpaceDialogWindow x:Class="SpacePlusPlus.Views.Dialogs.CleanupResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:SpacePlusPlus.Views.Dialogs"
        Width="560" SizeToContent="Height"
        Title="Cleanup results">
    <StackPanel>
        <Grid Height="40" Background="{DynamicResource Bg1}">
            <TextBlock Text="Cleanup results" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <Button Style="{StaticResource WindowButton}" Width="38" Height="28" HorizontalAlignment="Right"
                    Margin="0,0,8,0" IsCancel="True">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"/>
            </Button>
        </Grid>
        <StackPanel Margin="18,16,18,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Path x:Name="ResultIcon" Data="{StaticResource IconCheck}" Width="24" Height="24"
                      VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource AppText}" TextWrapping="Wrap"
                           MaxWidth="460" HorizontalAlignment="Left"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="StatusIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FreedText}" Style="{StaticResource MonoText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" Margin="22,2,0,0"
                                       TextWrapping="Wrap" MaxWidth="490" HorizontalAlignment="Left"
                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Success}" Value="True">
                                <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconCheck}"/>
                                <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource Success}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Success}" Value="False">
                                <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource IconWarning}"/>
                                <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource Warning}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Close" Style="{StaticResource BtnPrimary}" MinWidth="100" HorizontalAlignment="Right"
                    Margin="0,8,0,0" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</dialogs:SpaceDialogWindow>
