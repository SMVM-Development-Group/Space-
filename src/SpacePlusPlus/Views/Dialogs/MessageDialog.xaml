<dialogs:SpaceDialogWindow x:Class="SpacePlusPlus.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:SpacePlusPlus.Views.Dialogs"
        SizeToContent="WidthAndHeight" Width="460">
    <StackPanel>
        <Grid Height="40" Background="{DynamicResource Bg1}">
            <TextBlock Text="{Binding TitleText}" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <Button Style="{StaticResource WindowButton}" Width="38" Height="28" HorizontalAlignment="Right"
                    Margin="0,0,8,0" IsCancel="True">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"/>
            </Button>
        </Grid>
        <StackPanel Margin="18,16,18,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Path x:Name="Icon" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock Text="{Binding MessageText}" Style="{StaticResource AppText}" TextWrapping="Wrap"
                           MaxWidth="380" HorizontalAlignment="Left"/>
            </StackPanel>
            <Button Content="OK" Style="{StaticResource BtnPrimary}" MinWidth="100" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</dialogs:SpaceDialogWindow>
