<dialogs:SpaceDialogWindow x:Class="SpacePlusPlus.Views.Dialogs.FilePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:SpacePlusPlus.Views.Dialogs"
        Width="560" SizeToContent="Height"
        Title="File properties">
    <StackPanel>
        <Grid Height="40" Background="{DynamicResource Bg1}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Data="{StaticResource IconFile}" Style="{StaticResource IconPath}" Width="15" Height="15"/>
                <TextBlock Text="Properties" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
            <Button Style="{StaticResource WindowButton}" Width="38" Height="28" HorizontalAlignment="Right"
                    Margin="0,0,8,0" IsCancel="True">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"/>
            </Button>
        </Grid>
        <StackPanel Margin="18,16,18,16">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Name" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource AppText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeLine}" Style="{StaticResource AppText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="Modified" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Modified}" Style="{StaticResource AppText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="Type" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TypeName}" Style="{StaticResource AppText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Text="Category" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CategoryName}" Style="{StaticResource AppText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="5" Text="Attributes" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Attributes}" Style="{StaticResource AppText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="6" Text="Location" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FullPath}" Style="{StaticResource MonoText}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Open location" Style="{StaticResource BtnSecondary}" MinWidth="110" Margin="0,0,10,0"
                        Click="OpenLocation_Click"/>
                <Button Content="Close" Style="{StaticResource BtnPrimary}" MinWidth="90" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</dialogs:SpaceDialogWindow>
