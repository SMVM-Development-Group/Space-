<UserControl x:Class="SpacePlusPlus.Views.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="BloatAppRow">
            <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"
                                       ToolTip="{Binding Name}"/>
                            <Border Style="{StaticResource ChipCaution}" Margin="8,0,0,0"
                                    Visibility="{Binding Caution, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Caution" Style="{StaticResource ChipText}"
                                           Foreground="{DynamicResource Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="10.5"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="64" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StartupRow">
            <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="330"
                                       ToolTip="{Binding Command}"/>
                            <Border Style="{StaticResource ChipNeutral}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource ChipText}"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                            <Border Style="{StaticResource ChipCaution}" Margin="6,0,0,0"
                                    Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Disabled" Style="{StaticResource ChipText}"
                                           Foreground="{DynamicResource Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" Style="{StaticResource MutedText}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" MinWidth="50" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WindowsTweakRow">
            <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SubText}" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource ChipNeutral}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Category}" Style="{StaticResource ChipText}"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                            <Border Style="{StaticResource ChipCaution}" Margin="6,0,0,0"
                                    Visibility="{Binding Caution, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Review" Style="{StaticResource ChipText}" Foreground="{DynamicResource Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="10.5"
                                   TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ChipSafe}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Success}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconDebloat}" Style="{StaticResource IconPath}" Width="24" Height="24"
                      VerticalAlignment="Center"/>
                <TextBlock Text="Debloat" Style="{StaticResource PageTitle}" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" Margin="12,3,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"
                           ToolTip="{Binding StatusText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Re-analyze" Style="{StaticResource BtnSmall}" Command="{Binding AnalyzeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisInverted}}" MinWidth="96"/>
            </StackPanel>
        </Grid>

        <!-- Busy strip -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True"/>
            <TextBlock Text="{Binding CurrentItem}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Improvement report -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="16" Height="16"
                              Stroke="{DynamicResource Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="Improvement report" Style="{StaticResource SectionTitle}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OutcomeSummary}" Style="{StaticResource SubText}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="520"
                               ToolTip="{Binding OutcomeSummary}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ImprovementLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SubText}" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Before}" Style="{StaticResource MutedText}" MinWidth="90"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}"
                                          Width="10" Height="10" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding After}" Style="{StaticResource MonoText}" MinWidth="90"
                                               TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="All values are measured and verified. Full effect on memory usage and boot shows after a restart — Space++ does not estimate percentages it cannot verify."/>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="22,26" Margin="0,12,0,0"
                Visibility="{Binding HasNothing, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="26" Height="26"
                      Stroke="{DynamicResource Success}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Text="Nothing to debloat" Style="{StaticResource AppText}" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="No known preinstalled apps and no user autostart entries were found on this system."/>
            </StackPanel>
        </Border>

        <!-- Lists -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                      Visibility="{Binding HasNothing, Converter={StaticResource BoolToVisInverted}}">
            <StackPanel>

                <!-- Bloat apps -->
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,10"
                        Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Preinstalled apps" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipNeutral}" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource TextMuted}">
                                        <Run Text="{Binding Apps.Count, Mode=OneWay}"/><Run Text=" found"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Select all" Style="{StaticResource BtnSmall}"
                                        Command="{Binding SelectAllAppsCommand}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource BtnSmall}" Command="{Binding ClearAppsCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Packages detected as preinstalled bloat. Removal applies to the current user account; the Microsoft Store can reinstall any of them later."/>
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource BloatAppRow}"/>
                    </StackPanel>
                </Border>

                <!-- Autostart -->
                <Border Style="{StaticResource Card}" Padding="14,11"
                        Visibility="{Binding HasStartup, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Autostart" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource ChipNeutral}" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource TextMuted}">
                                        <Run Text="{Binding ActiveStartupCount, Mode=OneWay}"/><Run Text=" active · "/>
                                        <Run Text="{Binding DisabledCount, Mode=OneWay}"/><Run Text=" disabled"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Select all" Style="{StaticResource BtnSmall}"
                                        Command="{Binding SelectAllStartupCommand}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Style="{StaticResource BtnSmall}" Command="{Binding ClearStartupCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="User-level autostart entries (HKCU Run key and the Startup folder). Disabling uses the same mechanism as Task Manager and is fully reversible. System-wide entries are never touched."/>
                        <ItemsControl ItemsSource="{Binding Startup}" ItemTemplate="{StaticResource StartupRow}"/>
                    </StackPanel>
                </Border>

                <!-- Reversible Windows settings -->
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding HasTweaks, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Windows settings" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource ChipNeutral}" Margin="10,0,0,0">
                                <TextBlock Text="Reversible · current user" Style="{StaticResource ChipText}"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Choose only the features you do not use. These settings do not remove Windows components and can be restored from this page."/>
                        <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource WindowsTweakRow}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,11" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedAppText}" Style="{StaticResource SubText}"/>
                    <TextBlock Text="{Binding SelectedStartupText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedTweakText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnSmall}" MinWidth="110" Margin="0,0,10,0"
                            Command="{Binding EnableSelectedCommand}"
                            ToolTip="Re-enable the selected disabled entries">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" Width="12" Height="12"/>
                            <TextBlock Text="Re-enable" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSmall}" MinWidth="120" Margin="0,0,10,0"
                            Command="{Binding DisableSelectedCommand}"
                            ToolTip="Disable the selected autostart entries (reversible)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPause}" Style="{StaticResource IconPath}" Width="12" Height="12"/>
                            <TextBlock Text="Disable autostart" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnDanger}" Padding="12,5" Command="{Binding RemoveSelectedCommand}"
                            ToolTip="Remove the selected preinstalled apps for the current user">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" Width="13" Height="13"/>
                            <TextBlock Text="Remove apps" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSmall}" Padding="12,5" Margin="10,0,0,0"
                            Command="{Binding RestoreSelectedTweaksCommand}" ToolTip="Restore selected Windows settings">
                        <TextBlock Text="Restore settings"/>
                    </Button>
                    <Button Style="{StaticResource BtnPrimary}" Padding="12,5" Margin="10,0,0,0"
                            Command="{Binding ApplySelectedTweaksCommand}" ToolTip="Apply selected Windows settings">
                        <TextBlock Text="Apply settings"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
