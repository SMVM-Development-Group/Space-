<Window x:Class="SpacePlusPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Space++"
        Height="820" Width="1240" MinWidth="980" MinHeight="620"
        Background="{DynamicResource Bg0}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        xmlns:vm="clr-namespace:SpacePlusPlus.ViewModels"
        xmlns:views="clr-namespace:SpacePlusPlus.Views">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageMapViewModel}">
            <views:StorageMapPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}">
            <views:LargeFilesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
            <views:ApplicationsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmartCleanupViewModel}">
            <views:SmartCleanupPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloatViewModel}">
            <views:DebloatPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OneDriveViewModel}">
            <views:OneDrivePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanHistoryViewModel}">
            <views:ScanHistoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg1}" x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Data="M 4,10.5 A 2.5,2.5 0 0 1 6.5,8 L 17.5,8 A 2.5,2.5 0 0 1 20,10.5 L 20,14 A 2.5,2.5 0 0 1 17.5,16.5 L 6.5,16.5 A 2.5,2.5 0 0 1 4,14 Z"
                      Fill="{DynamicResource Accent}" Width="20" Height="20" Stretch="Uniform"/>
                <TextBlock Text="Space++" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Global search -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="440" Width="340" Margin="20,0,20,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  x:Name="SearchHost">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Tag="Search files, folders, apps… (Ctrl+F)" Padding="30,5,30,5" FontSize="12"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Width="14" Height="14"
                      Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <Button Style="{StaticResource BtnIcon}" Width="24" Height="24" HorizontalAlignment="Right"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="10" Height="10"/>
                </Button>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                       IsOpen="{Binding SearchOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" MinWidth="{Binding ElementName=SearchHost, Path=ActualWidth}">
                    <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource ControlBorder}"
                            BorderThickness="1" CornerRadius="9" Padding="4" MaxHeight="420" Margin="0,4,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnGhost}" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.ExecuteSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Padding="10,6" Margin="1" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="4" Height="4" CornerRadius="2" Background="{DynamicResource Accent}"
                                                        VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="380" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="380" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <Border Style="{StaticResource ChipNeutral}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Group}" Style="{StaticResource ChipText}"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Command="{Binding MinimizeCommand}" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Command="{Binding MaximizeRestoreCommand}" ToolTip="Maximize"
                        x:Name="MaximizeButton">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}"
                          Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Command="{Binding CloseCommand}" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,12">
                        <Separator Style="{StaticResource HSeparator}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding StatusVersionText}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectCommand}" Focusable="False">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                  Style="{StaticResource IconPath}" Width="17" Height="17"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="{Binding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,1,0,0">
            <Grid Height="28" Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorNotice}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Warning}" Margin="0,0,12,0"
                               Visibility="{Binding ErrorNotice, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
